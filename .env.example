# API
PORT=8000
JWT_ACCESS_SECRET=change-this-to-a-long-random-secret
LOCAL_USER=app
USER_ID=1000
GROUP_ID=1000

# Authentication
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCK_TTL_SECONDS=900
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-using-the-application

# PostgreSQL (used by Docker Compose)
POSTGRES_USER=auth
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=auth
POSTGRES_PORT=5432
DATABASE_URL=postgresql://auth:change-this-postgres-password@postgres:5432/auth?schema=public

# Redis (used by Docker Compose)
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
