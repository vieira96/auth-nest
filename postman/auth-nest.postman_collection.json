{
  "info": {
    "_postman_id": "b643be18-1b68-4f42-b4f6-5b19da0256df",
    "name": "auth-nest",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n\t\"name\": \"Maria Silva\",\n\t\"email\": \"maria@example.com\",\n\t\"password\": \"senha-segura-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('retorna 201 Created', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('não expõe o hash da senha', () => {",
                  "  pm.expect(pm.response.json()).not.to.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
